APP_NAME="Trading Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8 (in Docker the host is the "mysql" service)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trading
DB_USERNAME=trading
DB_PASSWORD=secret

# Redis is used for the queue, the cache (and its locks), and the latest prices
# REDIS_CLIENT is chosen automatically: phpredis if the extension is installed, else predis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

TRADING_CURRENCY=USD
TRADING_MARKET_BUY_COLLAR=0.05
TRADING_LIMIT_TTL_HOURS=24
TRADING_ORDER_RATE_LIMIT=60
